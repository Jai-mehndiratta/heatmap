# Reference configuration. Set these in your shell, your process manager, or
# the Render dashboard. This app reads environment variables directly and does
# not auto-load .env files.

# Where the SQLite snapshot database lives.
DATA_DIR=./data

# Number of parallel sector requests to MarketLens. Lower if rate-limited.
SYNC_CONCURRENCY=6

# Number of parallel price batches to Yahoo Finance. Lower if rate-limited.
YAHOO_CONCURRENCY=6

# Use the bundled universe.json sector universe instead of fetching MarketLens.
# Automatically enabled on Render, where MarketLens may return HTTP 403.
# USE_STATIC_UNIVERSE=1
# STATIC_UNIVERSE_PATH=./universe.json

# Optional: require a password to use the dashboard/API.
# DASHBOARD_PASSWORD=change-me

# Optional: upstream proxy for NSE access (useful from some cloud regions).
# MARKETLENS_PROXY=http://user:pass@proxy-host:port

# Optional: override the upstream source.
# MARKETLENS_BASE_URL=https://marketlens.nseindia.com

LOG_LEVEL=INFO
